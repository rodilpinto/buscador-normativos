# Cadeia de LLM (llm_cadeia/ — ver llm_cadeia/README.md). Tudo opcional: sem nenhum, o app roda sem LLM.
# Ordem de tentativa: [chave digitada pelo usuario na tela] > local > gemini > gemini-2
#   > groq > groq-2 > cerebras > cerebras-2 > openrouter > openrouter-2.  LLM_ORDEM troca a ordem (ex.: "gemini,groq,local").
# Cada provedor tem uma LISTA de modelos; cota/sobrecarga num modelo -> tenta o proximo
# modelo do mesmo provedor; chave invalida ou rede fora -> pula o provedor inteiro.
# Mudou Secrets na nuvem -> "Reboot app".

# Local — servidor OpenAI-compativel (LM Studio, Ollama, vLLM)
# ⚠ 10.10.111.125 e intranet da Camara: so funciona com o app rodando DENTRO da rede.
# LLM_BASE_URL = "http://10.10.111.125:1234/v1"
# LLM_MODEL = "google/gemma-4"          # varios: "modelo-a, modelo-b"
# LLM_API_KEY = ""

# Gemini (aistudio.google.com/apikey). Cota = por PROJETO e por MODELO.
GEMINI_API_KEY = "your-gemini-flash-api-key-here"   # nuati.secin
# GEMINI_API_KEY_2 = ""                              # outra conta/projeto = outra cota
# GEMINI_MODELS = "gemini-3.5-flash-lite, gemini-3.5-flash, gemini-2.5-flash-lite, gemini-2.5-flash, gemini-3-flash-preview, gemma-4-31b-it"

# Servicos gratuitos compativeis com OpenAI (modelos padrao em llm_cadeia/nucleo.py, PRESETS)
# Todo servico aceita segunda chave com sufixo _2 (convencao: sem sufixo = nuati.secin, _2 = rodilpinto)
# GROQ_API_KEY = ""          # console.groq.com/keys
# GROQ_API_KEY_2 = ""
# CEREBRAS_API_KEY = ""      # cloud.cerebras.ai
# OPENROUTER_API_KEY = ""    # openrouter.ai/keys
# GROQ_MODELS = ""  /  CEREBRAS_MODELS = ""  /  OPENROUTER_MODELS = ""   (trocam a lista padrao)

# Optional: for Google Custom Search API (alternative to googlesearch-python)
# GOOGLE_API_KEY = ""
# GOOGLE_CSE_ID = ""
