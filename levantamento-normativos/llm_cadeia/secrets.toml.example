# Segredos do llm_cadeia (README.md desta pasta, secao "Segredos").
# Copie para .streamlit/secrets.toml do app (ignorado pelo git) ou cole em Secrets do Streamlit Cloud.
# Preencha so o que tiver; provedor sem chave e pulado. Nunca commite chaves reais.
# Valores internos (endereco do servidor local, qual conta e qual): segredos.exemplo.toml da
# raiz do nuati-framework (repo privado). Nao os escreva nesta pasta.

# LLM local: so alcancavel de dentro da rede interna.
# LLM_BASE_URL = "http://<servidor-local>:1234/v1"
# LLM_MODEL = "<modelo-local>"
# LLM_API_KEY = ""                 # opcional
# LLM_TIMEOUT_S = "300"            # espera maxima pela resposta do local, em segundos
# LLM_DISABLE_THINKING = "1"       # desliga o raciocinio do modelo local (Gemma/Qwen)

# Sem sufixo = conta institucional; _2 = segunda conta (outro projeto Google soma cota do Gemini).
GEMINI_API_KEY = ""
GEMINI_API_KEY_2 = ""
GROQ_API_KEY = ""
GROQ_API_KEY_2 = ""
CEREBRAS_API_KEY = ""
CEREBRAS_API_KEY_2 = ""
OPENROUTER_API_KEY = ""
OPENROUTER_API_KEY_2 = ""

# Opcionais:
# LLM_ORDEM = "gemini-2,gemini,groq"   # troca a ordem (omitidos vao para o fim)
# LLM_SOMENTE = "groq"                 # so estes (para teste: prefira variavel de ambiente)
# GEMINI_MODELS = "gemini-3.5-flash-lite,gemini-3.5-flash"
# GEMINI_MODEL = "gemini-3.5-flash-lite"   # NAO e lido pelo llm_cadeia; so por codigo antigo de alguns apps
